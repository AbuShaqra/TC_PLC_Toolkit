.vscode/**
.git/**
.gitignore
.claude/**
.codex/**
scratch/**
test/**
sample/**
tsconfig.json
eslint.config.js
.github/**
**/*.map
node_modules/@types/**
**/.DS_Store
*.vsix
# scripts/ ships (generate-library-signatures.ps1 is invoked by the Update Library Definitions
# command), so the dev-only scripts in it must be excluded — one by one for loose files, and by
# directory for the sub-folders the rest have been organised into.
scripts/build-vsix.sh
scripts/run-build.bat
scripts/install-vsix.bat
scripts/make-icon.js
scripts/make-social-preview.js
scripts/glyphRaster.js
scripts/Create sample PLC project/**
scripts/Build PLC project/**
# The only thing in the repo that talks to the internet. It regenerates a committed data file and is
# run by a developer by hand; shipping it inside an extension whose whole premise is being offline
# would be wrong even though nothing invokes it.
scripts/fetch-pragma-catalog.js
# Webview test instrumentation for test/devhost/. The provider only emits its script tag when the
# dev-host harness sets TCDEV_TEST=1, so shipping it would be inert — but it is test code, and test
# code does not belong in the VSIX any more than test/** does.
media/devHostTestHook.js
# The 1280x640 GitHub social preview (generated by scripts/make-social-preview.js). Nothing in the
# extension references it; the marketplace icon package.json points at is media/marketplace-icon.png.
media/icon.png
CLAUDE.md
AGENTS.md
HANDOFF.md
ROADMAP.md
DEVELOPMENT.md
# Implementation plans — developer working documents, same category as the three files above.
docs/**
# Agent working directory: briefs, diffs, review reports. It is git-IGNORED, which is exactly why it
# needs listing here — .gitignore has no effect on what vsce packages, so this shipped 1.12 MB of
# internal review material (including identifiers redacted out of the source) until it was caught.
.superpowers/**

# R2 template SOURCE: raw XAE output. scripts/build-project-templates.js derives the shipped
# templates (resources/templates/tc3.1.4024/ and tc3.1.4026/) from it; those ship, this does not.
resources/templates/xae-3.1.4024/**
scripts/build-project-templates.js

# R3.3: the bundled compiler under resources/compiler/ SHIPS (the bundle, its two libraries, its
# licence files and SOURCE.md — the GPL-3.0 notices must reach every recipient). The script that
# writes it from a fork checkout is developer tooling.
scripts/vendor-compiler.js
