node_modules/
*.vsix
*.log
.DS_Store

# Per-machine Claude Code settings. `.claude/settings.json` IS committed (it declares the
# SessionStart hook that loads the shared memory bank); this one is personal and must not be.
.claude/settings.local.json

# The sample project the harnesses gate on. `sample/TcToolkitSample/` is WHOLLY SYNTHETIC — written
# by scripts/Create sample PLC project/build-sample-project.js, no customer or vendor content — and
# IS committed, so CI can run
# the diagnostics ratchet and the live-path guard instead of skipping them.
#
# Anything else under sample/ is a local, private project and must never be committed: exclude the
# directory's other contents, then re-admit the synthetic one. Note a plain `sample/` exclusion cannot
# work here — git does not descend into an excluded directory, so no negation inside it can ever fire.
sample/*
!sample/.gitignore
!sample/TcToolkitSample/

# Stale LSP index cache — may embed local source paths. Never commit.
.trust-lsp/

library-signatures.xml

# Generated by test/browser/build.js (the page + fixtures it serves to a browser), plus
# whatever Playwright drops while driving it. The harness scripts ARE committed; their output is not.
test/browser/out/
.playwright-mcp/

# Local playground. Nothing here is tracked — anything worth keeping belongs in test/ or scripts/.
scratch/
