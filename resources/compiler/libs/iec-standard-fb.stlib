    {
      "name": "CTU",
      "kind": "functionBlock",
      "header": "class CTU {\npublic:\n    // Inputs\n    IEC_BOOL CU;\n    IEC_BOOL R;\n    IEC_INT PV;\n    // Outputs\n    IEC_BOOL Q;\n    IEC_INT CV;\n    // Local variables\n    R_TRIG CU_T;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CTU();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CTU() = default;\n};\n",
      "cpp": "CTU::CTU() {\n    // Initialize variables\n}\n\nvoid CTU::operator()() {\n    CU_T.CLK = CU;\n    CU_T();\n    CU_T.ENO = true;\n    if (R) {\n        CV = 0;\n    } else if ((CU_T.Q) & ((CV < PV))) {\n        CV = CV + 1;\n    }\n    Q = (CV >= PV);\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        }
      ]
    },
    {
      "name": "CTD",
      "kind": "functionBlock",
      "header": "class CTD {\npublic:\n    // Inputs\n    IEC_BOOL CD;\n    IEC_BOOL LD;\n    IEC_INT PV;\n    // Outputs\n    IEC_BOOL Q;\n    IEC_INT CV;\n    // Local variables\n    R_TRIG CD_T;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CTD();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CTD() = default;\n};\n",
      "cpp": "CTD::CTD() {\n    // Initialize variables\n}\n\nvoid CTD::operator()() {\n    CD_T.CLK = CD;\n    CD_T();\n    CD_T.ENO = true;\n    if (LD) {\n        CV = PV;\n    } else if ((CD_T.Q) & ((CV > 0))) {\n        CV = CV - 1;\n    }\n    Q = (CV <= 0);\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        }
      ]
    },
    {
      "name": "CTUD",
      "kind": "functionBlock",
      "header": "class CTUD {\npublic:\n    // Inputs\n    IEC_BOOL CU;\n    IEC_BOOL CD;\n    IEC_BOOL R;\n    IEC_BOOL LD;\n    IEC_INT PV;\n    // Outputs\n    IEC_BOOL QU;\n    IEC_BOOL QD;\n    IEC_INT CV;\n    // Local variables\n    R_TRIG CU_T;\n    R_TRIG CD_T;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CTUD();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CTUD() = default;\n};\n",
      "cpp": "CTUD::CTUD() {\n    // Initialize variables\n}\n\nvoid CTUD::operator()() {\n    CU_T.CLK = CU;\n    CU_T();\n    CU_T.ENO = true;\n    CD_T.CLK = CD;\n    CD_T();\n    CD_T.ENO = true;\n    if (R) {\n        CV = 0;\n    } else if (LD) {\n        CV = PV;\n    } else if (NOT((CU_T.Q) & (CD_T.Q))) {\n        if ((CU_T.Q) & ((CV < PV))) {\n            CV = CV + 1;\n        } else if ((CD_T.Q) & ((CV > 0))) {\n            CV = CV - 1;\n        }\n    }\n    QU = (CV >= PV);\n    QD = (CV <= 0);\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        }
      ]
    },
