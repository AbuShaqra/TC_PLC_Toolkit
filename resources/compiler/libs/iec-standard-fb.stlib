      "cpp": "CTUD_UDINT::CTUD_UDINT() {\n    // Initialize variables\n}\n\nvoid CTUD_UDINT::operator()() {\n    CU_T.CLK = CU;\n    CU_T();\n    CU_T.ENO = true;\n    CD_T.CLK = CD;\n    CD_T();\n    CD_T.ENO = true;\n    if (R) {\n        CV = 0;\n    } else if (LD) {\n        CV = PV;\n    } else if (NOT((CU_T.Q) & (CD_T.Q))) {\n        if ((CU_T.Q) & ((CV < PV))) {\n            CV = CV + 1;\n        } else if ((CD_T.Q) & ((CV > 0))) {\n            CV = CV - 1;\n        }\n    }\n    QU = (CV >= PV);\n    QD = (CV <= 0);\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        }
      ]
    },
    {
      "name": "CTUD_ULINT",
      "kind": "functionBlock",
      "header": "class CTUD_ULINT {\npublic:\n    // Inputs\n    IEC_BOOL CU;\n    IEC_BOOL CD;\n    IEC_BOOL R;\n    IEC_BOOL LD;\n    IEC_ULINT PV;\n    // Outputs\n    IEC_BOOL QU;\n    IEC_BOOL QD;\n    IEC_ULINT CV;\n    // Local variables\n    R_TRIG CU_T;\n    R_TRIG CD_T;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CTUD_ULINT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CTUD_ULINT() = default;\n};\n",
      "cpp": "CTUD_ULINT::CTUD_ULINT() {\n    // Initialize variables\n}\n\nvoid CTUD_ULINT::operator()() {\n    CU_T.CLK = CU;\n    CU_T();\n    CU_T.ENO = true;\n    CD_T.CLK = CD;\n    CD_T();\n    CD_T.ENO = true;\n    if (R) {\n        CV = 0;\n    } else if (LD) {\n        CV = PV;\n    } else if (NOT((CU_T.Q) & (CD_T.Q))) {\n        if ((CU_T.Q) & ((CV < PV))) {\n            CV = CV + 1;\n        } else if ((CD_T.Q) & ((CV > 0))) {\n            CV = CV - 1;\n        }\n    }\n    QU = (CV >= PV);\n    QD = (CV <= 0);\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        }
      ]
    },
    {
      "name": "CONCAT_DATE",
      "kind": "function",
      "header": "IEC_DATE CONCAT_DATE(IEC_LINT YEAR, IEC_LINT MONTH, IEC_LINT DAY);",
      "cpp": "IEC_DATE CONCAT_DATE(IEC_LINT YEAR, IEC_LINT MONTH, IEC_LINT DAY) {\n    IEC_DATE CONCAT_DATE_result;\n    IEC_LINT Y;\n    IEC_LINT ERA;\n    IEC_LINT YOE;\n    IEC_LINT MP;\n    IEC_LINT DOY;\n    IEC_LINT DOE;\n    Y = YEAR;\n    if (MONTH <= 2) {\n        Y = Y - 1;\n    }\n    if (Y >= 0) {\n        ERA = Y / 400;\n    } else {\n        ERA = (Y - 399) / 400;\n    }\n    YOE = Y - ERA * 400;\n    if (MONTH > 2) {\n        MP = MONTH - 3;\n    } else {\n        MP = MONTH + 9;\n    }\n    DOY = (153 * MP + 2) / 5 + DAY - 1;\n    DOE = YOE * 365 + YOE / 4 - YOE / 100 + DOY;\n    CONCAT_DATE_result = TO_DATE(DATE_FROM_SECONDS((ERA * 146097 + DOE - 719468) * 86400));\n    return CONCAT_DATE_result;\n}\n",
      "deps": []
    },
    {
      "name": "CONCAT_TOD",
      "kind": "function",
      "header": "IEC_TOD CONCAT_TOD(IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND);",
      "cpp": "IEC_TOD CONCAT_TOD(IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND) {\n    IEC_TOD CONCAT_TOD_result;\n    CONCAT_TOD_result = TO_TOD(TOD_FROM_MS(((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND));\n    return CONCAT_TOD_result;\n}\n",
      "deps": []
    },
    {
      "name": "CONCAT_LTOD",
      "kind": "function",
      "header": "IEC_LTOD CONCAT_LTOD(IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND);",
      "cpp": "IEC_LTOD CONCAT_LTOD(IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND) {\n    IEC_LTOD CONCAT_LTOD_result;\n    CONCAT_LTOD_result = TO_LTOD((((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000);\n    return CONCAT_LTOD_result;\n}\n",
      "deps": []
    },
    {
      "name": "CONCAT_LDT",
      "kind": "function",
      "header": "IEC_LDT CONCAT_LDT(IEC_LINT YEAR, IEC_LINT MONTH, IEC_LINT DAY, IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND);",
      "cpp": "IEC_LDT CONCAT_LDT(IEC_LINT YEAR, IEC_LINT MONTH, IEC_LINT DAY, IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND) {\n    IEC_LDT CONCAT_LDT_result;\n    IEC_LINT Y;\n    IEC_LINT ERA;\n    IEC_LINT YOE;\n    IEC_LINT MP;\n    IEC_LINT DOY;\n    IEC_LINT DOE;\n    Y = YEAR;\n    if (MONTH <= 2) {\n        Y = Y - 1;\n    }\n    if (Y >= 0) {\n        ERA = Y / 400;\n    } else {\n        ERA = (Y - 399) / 400;\n    }\n    YOE = Y - ERA * 400;\n    if (MONTH > 2) {\n        MP = MONTH - 3;\n    } else {\n        MP = MONTH + 9;\n    }\n    DOY = (153 * MP + 2) / 5 + DAY - 1;\n    DOE = YOE * 365 + YOE / 4 - YOE / 100 + DOY;\n    CONCAT_LDT_result = TO_LDT((ERA * 146097 + DOE - 719468) * 86400000000000 + (((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000);\n    return CONCAT_LDT_result;\n}\n",
      "deps": []
    },
    {
      "name": "CONCAT_DT",
      "kind": "function",
      "header": "IEC_DT CONCAT_DT(IEC_LINT YEAR, IEC_LINT MONTH, IEC_LINT DAY, IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND);",
      "cpp": "IEC_DT CONCAT_DT(IEC_LINT YEAR, IEC_LINT MONTH, IEC_LINT DAY, IEC_LINT HOUR, IEC_LINT MINUTE, IEC_LINT SECOND, IEC_LINT MILLISECOND) {\n    IEC_DT CONCAT_DT_result;\n    IEC_LINT Y;\n    IEC_LINT ERA;\n    IEC_LINT YOE;\n    IEC_LINT MP;\n    IEC_LINT DOY;\n    IEC_LINT DOE;\n    Y = YEAR;\n    if (MONTH <= 2) {\n        Y = Y - 1;\n    }\n    if (Y >= 0) {\n        ERA = Y / 400;\n    } else {\n        ERA = (Y - 399) / 400;\n    }\n    YOE = Y - ERA * 400;\n    if (MONTH > 2) {\n        MP = MONTH - 3;\n    } else {\n        MP = MONTH + 9;\n    }\n    DOY = (153 * MP + 2) / 5 + DAY - 1;\n    DOE = YOE * 365 + YOE / 4 - YOE / 100 + DOY;\n    CONCAT_DT_result = TO_DT(TO_LDT((ERA * 146097 + DOE - 719468) * 86400000000000 + (((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000));\n    return CONCAT_DT_result;\n}\n",
      "deps": []
    },
    {
      "name": "CONCAT_DATE_LTOD",
      "kind": "function",
      "header": "IEC_LDT CONCAT_DATE_LTOD(IEC_DATE DATE_IN, IEC_LTOD TOD_IN);",
      "cpp": "IEC_LDT CONCAT_DATE_LTOD(IEC_DATE DATE_IN, IEC_LTOD TOD_IN) {\n    IEC_LDT CONCAT_DATE_LTOD_result;\n    CONCAT_DATE_LTOD_result = TO_LDT(TO_LINT(DATE_TO_NS(DATE_IN)) + TO_LINT(TOD_IN));\n    return CONCAT_DATE_LTOD_result;\n}\n",
      "deps": []
    },
    {
      "name": "SPLIT_DATE",
      "kind": "function",
      "header": "IEC_BOOL SPLIT_DATE(IEC_DATE IN, IEC_UINT& YEAR, IEC_USINT& MONTH, IEC_USINT& DAY);",
      "cpp": "IEC_BOOL SPLIT_DATE(IEC_DATE IN, IEC_UINT& YEAR, IEC_USINT& MONTH, IEC_USINT& DAY) {\n    IEC_BOOL SPLIT_DATE_result;\n    IEC_LINT Z;\n    IEC_LINT ERA;\n    IEC_LINT DOE;\n    IEC_LINT YOE;\n    IEC_LINT DOY;\n    IEC_LINT MP;\n    IEC_LINT Y;\n    IEC_LINT M;\n    Z = TO_LINT(DATE_TO_SECONDS(IN)) / 86400 + 719468;\n    if (Z >= 0) {\n        ERA = Z / 146097;\n    } else {\n        ERA = (Z - 146096) / 146097;\n    }\n    DOE = Z - ERA * 146097;\n    YOE = (DOE - DOE / 1460 + DOE / 36524 - DOE / 146096) / 365;\n    DOY = DOE - (365 * YOE + YOE / 4 - YOE / 100);\n    MP = (5 * DOY + 2) / 153;\n    DAY = TO_USINT(DOY - (153 * MP + 2) / 5 + 1);\n    if (MP < 10) {\n        M = MP + 3;\n    } else {\n        M = MP - 9;\n    }\n    Y = YOE + ERA * 400;\n    if (M <= 2) {\n        Y = Y + 1;\n    }\n    MONTH = TO_USINT(M);\n    YEAR = TO_UINT(Y);\n    SPLIT_DATE_result = true;\n    return SPLIT_DATE_result;\n}\n",
      "deps": []
    },
    {
      "name": "SPLIT_TOD",
      "kind": "function",
      "header": "IEC_BOOL SPLIT_TOD(IEC_TOD IN, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND);",
      "cpp": "IEC_BOOL SPLIT_TOD(IEC_TOD IN, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND) {\n    IEC_BOOL SPLIT_TOD_result;\n    IEC_LINT MS;\n    MS = TO_LINT(TOD_TO_MS(IN));\n    HOUR = TO_USINT(MS / 3600000);\n    MINUTE = TO_USINT(MS / 60000 % 60);\n    SECOND = TO_USINT(MS / 1000 % 60);\n    MILLISECOND = TO_UINT(MS % 1000);\n    SPLIT_TOD_result = true;\n    return SPLIT_TOD_result;\n}\n",
      "deps": []
    },
    {
      "name": "SPLIT_LTOD",
      "kind": "function",
      "header": "IEC_BOOL SPLIT_LTOD(IEC_LTOD IN, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND);",
      "cpp": "IEC_BOOL SPLIT_LTOD(IEC_LTOD IN, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND) {\n    IEC_BOOL SPLIT_LTOD_result;\n    IEC_LINT MS;\n    MS = TO_LINT(IN) / 1000000;\n    HOUR = TO_USINT(MS / 3600000);\n    MINUTE = TO_USINT(MS / 60000 % 60);\n    SECOND = TO_USINT(MS / 1000 % 60);\n    MILLISECOND = TO_UINT(MS % 1000);\n    SPLIT_LTOD_result = true;\n    return SPLIT_LTOD_result;\n}\n",
      "deps": []
    },
    {
      "name": "SPLIT_LDT",
      "kind": "function",
      "header": "IEC_BOOL SPLIT_LDT(IEC_LDT IN, IEC_UINT& YEAR, IEC_USINT& MONTH, IEC_USINT& DAY, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND);",
      "cpp": "IEC_BOOL SPLIT_LDT(IEC_LDT IN, IEC_UINT& YEAR, IEC_USINT& MONTH, IEC_USINT& DAY, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND) {\n    IEC_BOOL SPLIT_LDT_result;\n    IEC_LINT NS;\n    IEC_LINT DAYS;\n    IEC_LINT MS;\n    IEC_LINT Z;\n    IEC_LINT ERA;\n    IEC_LINT DOE;\n    IEC_LINT YOE;\n    IEC_LINT DOY;\n    IEC_LINT MP;\n    IEC_LINT Y;\n    IEC_LINT M;\n    NS = TO_LINT(IN);\n    DAYS = NS / 86400000000000;\n    if ((NS < 0) & (DAYS * 86400000000000 != NS)) {\n        DAYS = DAYS - 1;\n    }\n    Z = DAYS + 719468;\n    if (Z >= 0) {\n        ERA = Z / 146097;\n    } else {\n        ERA = (Z - 146096) / 146097;\n    }\n    DOE = Z - ERA * 146097;\n    YOE = (DOE - DOE / 1460 + DOE / 36524 - DOE / 146096) / 365;\n    DOY = DOE - (365 * YOE + YOE / 4 - YOE / 100);\n    MP = (5 * DOY + 2) / 153;\n    DAY = TO_USINT(DOY - (153 * MP + 2) / 5 + 1);\n    if (MP < 10) {\n        M = MP + 3;\n    } else {\n        M = MP - 9;\n    }\n    Y = YOE + ERA * 400;\n    if (M <= 2) {\n        Y = Y + 1;\n    }\n    MONTH = TO_USINT(M);\n    YEAR = TO_UINT(Y);\n    MS = (NS - DAYS * 86400000000000) / 1000000;\n    HOUR = TO_USINT(MS / 3600000);\n    MINUTE = TO_USINT(MS / 60000 % 60);\n    SECOND = TO_USINT(MS / 1000 % 60);\n    MILLISECOND = TO_UINT(MS % 1000);\n    SPLIT_LDT_result = true;\n    return SPLIT_LDT_result;\n}\n",
      "deps": []
    },
    {
      "name": "SPLIT_DT",
      "kind": "function",
      "header": "IEC_BOOL SPLIT_DT(IEC_DT IN, IEC_UINT& YEAR, IEC_USINT& MONTH, IEC_USINT& DAY, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND);",
      "cpp": "IEC_BOOL SPLIT_DT(IEC_DT IN, IEC_UINT& YEAR, IEC_USINT& MONTH, IEC_USINT& DAY, IEC_USINT& HOUR, IEC_USINT& MINUTE, IEC_USINT& SECOND, IEC_UINT& MILLISECOND) {\n    IEC_BOOL SPLIT_DT_result;\n    IEC_LINT NS;\n    IEC_LINT DAYS;\n    IEC_LINT MS;\n    IEC_LINT Z;\n    IEC_LINT ERA;\n    IEC_LINT DOE;\n    IEC_LINT YOE;\n    IEC_LINT DOY;\n    IEC_LINT MP;\n    IEC_LINT Y;\n    IEC_LINT M;\n    NS = TO_LINT(TO_LDT(IN));\n    DAYS = NS / 86400000000000;\n    if ((NS < 0) & (DAYS * 86400000000000 != NS)) {\n        DAYS = DAYS - 1;\n    }\n    Z = DAYS + 719468;\n    if (Z >= 0) {\n        ERA = Z / 146097;\n    } else {\n        ERA = (Z - 146096) / 146097;\n    }\n    DOE = Z - ERA * 146097;\n    YOE = (DOE - DOE / 1460 + DOE / 36524 - DOE / 146096) / 365;\n    DOY = DOE - (365 * YOE + YOE / 4 - YOE / 100);\n    MP = (5 * DOY + 2) / 153;\n    DAY = TO_USINT(DOY - (153 * MP + 2) / 5 + 1);\n    if (MP < 10) {\n        M = MP + 3;\n    } else {\n        M = MP - 9;\n    }\n    Y = YOE + ERA * 400;\n    if (M <= 2) {\n        Y = Y + 1;\n    }\n    MONTH = TO_USINT(M);\n    YEAR = TO_UINT(Y);\n    MS = (NS - DAYS * 86400000000000) / 1000000;\n    HOUR = TO_USINT(MS / 3600000);\n    MINUTE = TO_USINT(MS / 60000 % 60);\n    SECOND = TO_USINT(MS / 1000 % 60);\n    MILLISECOND = TO_UINT(MS % 1000);\n    SPLIT_DT_result = true;\n    return SPLIT_DT_result;\n}\n",
      "deps": []
    },
    {
      "name": "DAY_OF_WEEK",
      "kind": "function",
      "header": "IEC_INT DAY_OF_WEEK(IEC_DATE IN);",
      "cpp": "IEC_INT DAY_OF_WEEK(IEC_DATE IN) {\n    IEC_INT DAY_OF_WEEK_result;\n    IEC_LINT DAYS;\n    DAYS = TO_LINT(DATE_TO_SECONDS(IN)) / 86400;\n    DAY_OF_WEEK_result = TO_INT(((DAYS % 7) + 7 + 4) % 7);\n    return DAY_OF_WEEK_result;\n}\n",
      "deps": []
    }
  ],
  "dependencies": [],
  "sources": [
    {
      "fileName": "edge_detection.st",
      "source": "(* IEC 61131-3 Standard Function Blocks: Edge Detection *)\n\nFUNCTION_BLOCK R_TRIG\n  VAR_INPUT CLK : BOOL; END_VAR\n  VAR_OUTPUT Q : BOOL; END_VAR\n  VAR RETAIN M : BOOL; END_VAR\n  Q := CLK AND NOT M;\n  M := CLK;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK F_TRIG\n  VAR_INPUT CLK : BOOL; END_VAR\n  VAR_OUTPUT Q : BOOL; END_VAR\n  VAR RETAIN M : BOOL := TRUE; END_VAR\n  Q := NOT CLK AND NOT M;\n  M := NOT CLK;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "bistable.st",
      "source": "(* IEC 61131-3 Standard Function Blocks: Bistable Latches *)\n\nFUNCTION_BLOCK SR\n  VAR_INPUT S1, R : BOOL; END_VAR\n  VAR_OUTPUT Q1 : BOOL; END_VAR\n  Q1 := S1 OR ((NOT R) AND Q1);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK RS\n  VAR_INPUT S, R1 : BOOL; END_VAR\n  VAR_OUTPUT Q1 : BOOL; END_VAR\n  Q1 := (NOT R1) AND (S OR Q1);\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "sema.st",
      "source": "(* IEC 61131-3 Standard Function Blocks: Semaphore *)\n\nFUNCTION_BLOCK SEMA\n  VAR_INPUT\n    CLAIM : BOOL;\n    RELEASE : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    BUSY : BOOL;\n  END_VAR\n  VAR\n    Q_INTERNAL : BOOL;\n  END_VAR\n\n  Q_INTERNAL := CLAIM OR ( Q_INTERNAL AND (NOT RELEASE));\n  BUSY := Q_INTERNAL;\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "counter.st",
      "source": "(* IEC 61131-3 Standard Function Blocks: Counters *)\n(* Edge semantics and the CODESYS alignment: docs/IEC_COMPLIANCE.md, Standard Function Blocks *)\n\nFUNCTION_BLOCK CTU\n  VAR_INPUT\n    CU : BOOL;\n    R : BOOL;\n    PV : INT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : INT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  IF R THEN\n    CV := 0;\n  ELSIF CU_T.Q AND (CV < PV) THEN\n    CV := CV + 1;\n  END_IF;\n  Q := (CV >= PV);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTD\n  VAR_INPUT\n    CD : BOOL;\n    LD : BOOL;\n    PV : INT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : INT;\n  END_VAR\n  VAR\n    CD_T : R_TRIG;\n  END_VAR\n  CD_T(CLK := CD);\n  IF LD THEN\n    CV := PV;\n  ELSIF CD_T.Q AND (CV > 0) THEN\n    CV := CV - 1;\n  END_IF;\n  Q := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTUD\n  VAR_INPUT\n    CU : BOOL;\n    CD : BOOL;\n    R : BOOL;\n    LD : BOOL;\n    PV : INT;\n  END_VAR\n  VAR_OUTPUT\n    QU : BOOL;\n    QD : BOOL;\n    CV : INT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n    CD_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  CD_T(CLK := CD);\n  IF R THEN\n    CV := 0;\n  ELSIF LD THEN\n    CV := PV;\n  ELSIF NOT (CU_T.Q AND CD_T.Q) THEN\n    IF CU_T.Q AND (CV < PV) THEN\n      CV := CV + 1;\n    ELSIF CD_T.Q AND (CV > 0) THEN\n      CV := CV - 1;\n    END_IF;\n  END_IF;\n  QU := (CV >= PV);\n  QD := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTU_DINT\n  VAR_INPUT\n    CU : BOOL;\n    R : BOOL;\n    PV : DINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : DINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  IF R THEN\n    CV := 0;\n  ELSIF CU_T.Q AND (CV < PV) THEN\n    CV := CV + 1;\n  END_IF;\n  Q := (CV >= PV);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTU_LINT\n  VAR_INPUT\n    CU : BOOL;\n    R : BOOL;\n    PV : LINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : LINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  IF R THEN\n    CV := 0;\n  ELSIF CU_T.Q AND (CV < PV) THEN\n    CV := CV + 1;\n  END_IF;\n  Q := (CV >= PV);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTU_UDINT\n  VAR_INPUT\n    CU : BOOL;\n    R : BOOL;\n    PV : UDINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : UDINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  IF R THEN\n    CV := 0;\n  ELSIF CU_T.Q AND (CV < PV) THEN\n    CV := CV + 1;\n  END_IF;\n  Q := (CV >= PV);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTU_ULINT\n  VAR_INPUT\n    CU : BOOL;\n    R : BOOL;\n    PV : ULINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : ULINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  IF R THEN\n    CV := 0;\n  ELSIF CU_T.Q AND (CV < PV) THEN\n    CV := CV + 1;\n  END_IF;\n  Q := (CV >= PV);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTD_DINT\n  VAR_INPUT\n    CD : BOOL;\n    LD : BOOL;\n    PV : DINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : DINT;\n  END_VAR\n  VAR\n    CD_T : R_TRIG;\n  END_VAR\n  CD_T(CLK := CD);\n  IF LD THEN\n    CV := PV;\n  ELSIF CD_T.Q AND (CV > 0) THEN\n    CV := CV - 1;\n  END_IF;\n  Q := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTD_LINT\n  VAR_INPUT\n    CD : BOOL;\n    LD : BOOL;\n    PV : LINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : LINT;\n  END_VAR\n  VAR\n    CD_T : R_TRIG;\n  END_VAR\n  CD_T(CLK := CD);\n  IF LD THEN\n    CV := PV;\n  ELSIF CD_T.Q AND (CV > 0) THEN\n    CV := CV - 1;\n  END_IF;\n  Q := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTD_UDINT\n  VAR_INPUT\n    CD : BOOL;\n    LD : BOOL;\n    PV : UDINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : UDINT;\n  END_VAR\n  VAR\n    CD_T : R_TRIG;\n  END_VAR\n  CD_T(CLK := CD);\n  IF LD THEN\n    CV := PV;\n  ELSIF CD_T.Q AND (CV > 0) THEN\n    CV := CV - 1;\n  END_IF;\n  Q := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTD_ULINT\n  VAR_INPUT\n    CD : BOOL;\n    LD : BOOL;\n    PV : ULINT;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    CV : ULINT;\n  END_VAR\n  VAR\n    CD_T : R_TRIG;\n  END_VAR\n  CD_T(CLK := CD);\n  IF LD THEN\n    CV := PV;\n  ELSIF CD_T.Q AND (CV > 0) THEN\n    CV := CV - 1;\n  END_IF;\n  Q := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTUD_DINT\n  VAR_INPUT\n    CU : BOOL;\n    CD : BOOL;\n    R : BOOL;\n    LD : BOOL;\n    PV : DINT;\n  END_VAR\n  VAR_OUTPUT\n    QU : BOOL;\n    QD : BOOL;\n    CV : DINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n    CD_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  CD_T(CLK := CD);\n  IF R THEN\n    CV := 0;\n  ELSIF LD THEN\n    CV := PV;\n  ELSIF NOT (CU_T.Q AND CD_T.Q) THEN\n    IF CU_T.Q AND (CV < PV) THEN\n      CV := CV + 1;\n    ELSIF CD_T.Q AND (CV > 0) THEN\n      CV := CV - 1;\n    END_IF;\n  END_IF;\n  QU := (CV >= PV);\n  QD := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTUD_LINT\n  VAR_INPUT\n    CU : BOOL;\n    CD : BOOL;\n    R : BOOL;\n    LD : BOOL;\n    PV : LINT;\n  END_VAR\n  VAR_OUTPUT\n    QU : BOOL;\n    QD : BOOL;\n    CV : LINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n    CD_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  CD_T(CLK := CD);\n  IF R THEN\n    CV := 0;\n  ELSIF LD THEN\n    CV := PV;\n  ELSIF NOT (CU_T.Q AND CD_T.Q) THEN\n    IF CU_T.Q AND (CV < PV) THEN\n      CV := CV + 1;\n    ELSIF CD_T.Q AND (CV > 0) THEN\n      CV := CV - 1;\n    END_IF;\n  END_IF;\n  QU := (CV >= PV);\n  QD := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTUD_UDINT\n  VAR_INPUT\n    CU : BOOL;\n    CD : BOOL;\n    R : BOOL;\n    LD : BOOL;\n    PV : UDINT;\n  END_VAR\n  VAR_OUTPUT\n    QU : BOOL;\n    QD : BOOL;\n    CV : UDINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n    CD_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  CD_T(CLK := CD);\n  IF R THEN\n    CV := 0;\n  ELSIF LD THEN\n    CV := PV;\n  ELSIF NOT (CU_T.Q AND CD_T.Q) THEN\n    IF CU_T.Q AND (CV < PV) THEN\n      CV := CV + 1;\n    ELSIF CD_T.Q AND (CV > 0) THEN\n      CV := CV - 1;\n    END_IF;\n  END_IF;\n  QU := (CV >= PV);\n  QD := (CV <= 0);\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK CTUD_ULINT\n  VAR_INPUT\n    CU : BOOL;\n    CD : BOOL;\n    R : BOOL;\n    LD : BOOL;\n    PV : ULINT;\n  END_VAR\n  VAR_OUTPUT\n    QU : BOOL;\n    QD : BOOL;\n    CV : ULINT;\n  END_VAR\n  VAR\n    CU_T : R_TRIG;\n    CD_T : R_TRIG;\n  END_VAR\n  CU_T(CLK := CU);\n  CD_T(CLK := CD);\n  IF R THEN\n    CV := 0;\n  ELSIF LD THEN\n    CV := PV;\n  ELSIF NOT (CU_T.Q AND CD_T.Q) THEN\n    IF CU_T.Q AND (CV < PV) THEN\n      CV := CV + 1;\n    ELSIF CD_T.Q AND (CV > 0) THEN\n      CV := CV - 1;\n    END_IF;\n  END_IF;\n  QU := (CV >= PV);\n  QD := (CV <= 0);\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "timer.st",
      "source": "(* IEC 61131-3 Standard Function Blocks: Timers *)\n(* Uses TIME() built-in function for current time (CODESYS-compatible) *)\n\nFUNCTION_BLOCK TON\n  VAR_INPUT\n    IN : BOOL;\n    PT : TIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : TIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : TIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := FALSE;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (NOT(IN)) THEN\n      ET := T#0s;\n      Q := FALSE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := TRUE;\n        ET := PT;\n      ELSE\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TOF\n  VAR_INPUT\n    IN : BOOL;\n    PT : TIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : TIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : TIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND PREV_IN AND NOT(IN)) THEN\n    STATE := 1;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (IN) THEN\n      ET := T#0s;\n      Q := TRUE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := FALSE;\n        ET := PT;\n      ELSE\n        Q := TRUE;\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TP\n  VAR_INPUT\n    IN : BOOL;\n    PT : TIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : TIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : TIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := TRUE;\n    START_TIME := CURRENT_TIME;\n  ELSIF (STATE = 1) THEN\n    IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n      STATE := 2;\n      Q := FALSE;\n      ET := PT;\n    ELSE\n      ET := CURRENT_TIME - START_TIME;\n    END_IF;\n  END_IF;\n\n  IF (NOT(IN) AND (STATE = 2)) THEN\n    STATE := 0;\n    ET := T#0s;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\n(* LTIME variants: preset and elapsed time are LTIME (64-bit nanoseconds) *)\n\nFUNCTION_BLOCK LTON\n  VAR_INPUT\n    IN : BOOL;\n    PT : LTIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : LTIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : LTIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := FALSE;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (NOT(IN)) THEN\n      ET := LTIME#0s;\n      Q := FALSE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := TRUE;\n        ET := PT;\n      ELSE\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK LTOF\n  VAR_INPUT\n    IN : BOOL;\n    PT : LTIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : LTIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : LTIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND PREV_IN AND NOT(IN)) THEN\n    STATE := 1;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (IN) THEN\n      ET := LTIME#0s;\n      Q := TRUE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := FALSE;\n        ET := PT;\n      ELSE\n        Q := TRUE;\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK LTP\n  VAR_INPUT\n    IN : BOOL;\n    PT : LTIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : LTIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : LTIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := TRUE;\n    START_TIME := CURRENT_TIME;\n  ELSIF (STATE = 1) THEN\n    IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n      STATE := 2;\n      Q := FALSE;\n      ET := PT;\n    ELSE\n      ET := CURRENT_TIME - START_TIME;\n    END_IF;\n  END_IF;\n\n  IF (NOT(IN) AND (STATE = 2)) THEN\n    STATE := 0;\n    ET := LTIME#0s;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\n(* The typed names of Table 46: TP_TIME, TON_TIME, TOF_TIME on TIME and\n   TP_LTIME, TON_LTIME, TOF_LTIME on LTIME *)\n\nFUNCTION_BLOCK TP_TIME\n  VAR_INPUT\n    IN : BOOL;\n    PT : TIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : TIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : TIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := TRUE;\n    START_TIME := CURRENT_TIME;\n  ELSIF (STATE = 1) THEN\n    IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n      STATE := 2;\n      Q := FALSE;\n      ET := PT;\n    ELSE\n      ET := CURRENT_TIME - START_TIME;\n    END_IF;\n  END_IF;\n\n  IF (NOT(IN) AND (STATE = 2)) THEN\n    STATE := 0;\n    ET := T#0s;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TP_LTIME\n  VAR_INPUT\n    IN : BOOL;\n    PT : LTIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : LTIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : LTIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := TRUE;\n    START_TIME := CURRENT_TIME;\n  ELSIF (STATE = 1) THEN\n    IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n      STATE := 2;\n      Q := FALSE;\n      ET := PT;\n    ELSE\n      ET := CURRENT_TIME - START_TIME;\n    END_IF;\n  END_IF;\n\n  IF (NOT(IN) AND (STATE = 2)) THEN\n    STATE := 0;\n    ET := LTIME#0s;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TON_TIME\n  VAR_INPUT\n    IN : BOOL;\n    PT : TIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : TIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : TIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := FALSE;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (NOT(IN)) THEN\n      ET := T#0s;\n      Q := FALSE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := TRUE;\n        ET := PT;\n      ELSE\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TON_LTIME\n  VAR_INPUT\n    IN : BOOL;\n    PT : LTIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : LTIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : LTIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND NOT(PREV_IN) AND IN) THEN\n    STATE := 1;\n    Q := FALSE;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (NOT(IN)) THEN\n      ET := LTIME#0s;\n      Q := FALSE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := TRUE;\n        ET := PT;\n      ELSE\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TOF_TIME\n  VAR_INPUT\n    IN : BOOL;\n    PT : TIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : TIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : TIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND PREV_IN AND NOT(IN)) THEN\n    STATE := 1;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (IN) THEN\n      ET := T#0s;\n      Q := TRUE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := FALSE;\n        ET := PT;\n      ELSE\n        Q := TRUE;\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK TOF_LTIME\n  VAR_INPUT\n    IN : BOOL;\n    PT : LTIME;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n    ET : LTIME;\n  END_VAR\n  VAR\n    STATE : SINT;\n    PREV_IN : BOOL;\n    CURRENT_TIME, START_TIME : LTIME;\n  END_VAR\n\n  CURRENT_TIME := TIME();\n\n  IF ((STATE = 0) AND PREV_IN AND NOT(IN)) THEN\n    STATE := 1;\n    START_TIME := CURRENT_TIME;\n  ELSE\n    IF (IN) THEN\n      ET := LTIME#0s;\n      Q := TRUE;\n      STATE := 0;\n    ELSIF (STATE = 1) THEN\n      IF ((START_TIME + PT) <= CURRENT_TIME) THEN\n        STATE := 2;\n        Q := FALSE;\n        ET := PT;\n      ELSE\n        Q := TRUE;\n        ET := CURRENT_TIME - START_TIME;\n      END_IF;\n    END_IF;\n  END_IF;\n\n  PREV_IN := IN;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "time_functions.st",
      "source": "(* IEC 61131-3 Ed. 3 Table 36: concatenating and splitting dates and times.\n   Inputs take any integer (as LINT); YEAR and MILLISECOND come out as UINT,\n   the other parts as USINT. SPLIT_* returns TRUE. Dates use the proleptic\n   Gregorian calendar. No function calls another, so a library declaring one\n   of these names hides that function only. *)\n\nFUNCTION CONCAT_DATE : DATE\n  VAR_INPUT YEAR, MONTH, DAY : LINT; END_VAR\n  VAR y, era, yoe, mp, doy, doe : LINT; END_VAR\n  y := YEAR;\n  IF MONTH <= 2 THEN y := y - 1; END_IF;\n  IF y >= 0 THEN era := y / 400; ELSE era := (y - 399) / 400; END_IF;\n  yoe := y - era * 400;\n  IF MONTH > 2 THEN mp := MONTH - 3; ELSE mp := MONTH + 9; END_IF;\n  doy := (153 * mp + 2) / 5 + DAY - 1;\n  doe := yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  CONCAT_DATE := LINT_TO_DATE((era * 146097 + doe - 719468) * 86400);\nEND_FUNCTION\n\nFUNCTION CONCAT_TOD : TOD\n  VAR_INPUT HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR\n  CONCAT_TOD := LINT_TO_TOD(((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND);\nEND_FUNCTION\n\nFUNCTION CONCAT_LTOD : LTOD\n  VAR_INPUT HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR\n  CONCAT_LTOD := LINT_TO_LTOD((((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000);\nEND_FUNCTION\n\nFUNCTION CONCAT_LDT : LDT\n  VAR_INPUT YEAR, MONTH, DAY, HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR\n  VAR y, era, yoe, mp, doy, doe : LINT; END_VAR\n  y := YEAR;\n  IF MONTH <= 2 THEN y := y - 1; END_IF;\n  IF y >= 0 THEN era := y / 400; ELSE era := (y - 399) / 400; END_IF;\n  yoe := y - era * 400;\n  IF MONTH > 2 THEN mp := MONTH - 3; ELSE mp := MONTH + 9; END_IF;\n  doy := (153 * mp + 2) / 5 + DAY - 1;\n  doe := yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  CONCAT_LDT := LINT_TO_LDT((era * 146097 + doe - 719468) * 86400000000000\n    + (((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000);\nEND_FUNCTION\n\nFUNCTION CONCAT_DT : DT\n  VAR_INPUT YEAR, MONTH, DAY, HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR\n  VAR y, era, yoe, mp, doy, doe : LINT; END_VAR\n  y := YEAR;\n  IF MONTH <= 2 THEN y := y - 1; END_IF;\n  IF y >= 0 THEN era := y / 400; ELSE era := (y - 399) / 400; END_IF;\n  yoe := y - era * 400;\n  IF MONTH > 2 THEN mp := MONTH - 3; ELSE mp := MONTH + 9; END_IF;\n  doy := (153 * mp + 2) / 5 + DAY - 1;\n  doe := yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  CONCAT_DT := LDT_TO_DT(LINT_TO_LDT((era * 146097 + doe - 719468) * 86400000000000\n    + (((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000));\nEND_FUNCTION\n\nFUNCTION CONCAT_DATE_LTOD : LDT\n  VAR_INPUT DATE_IN : DATE; TOD_IN : LTOD; END_VAR\n  CONCAT_DATE_LTOD := LINT_TO_LDT(LDATE_TO_LINT(DATE_IN) + LTOD_TO_LINT(TOD_IN));\nEND_FUNCTION\n\nFUNCTION SPLIT_DATE : BOOL\n  VAR_INPUT IN : DATE; END_VAR\n  VAR_OUTPUT YEAR : UINT; MONTH, DAY : USINT; END_VAR\n  VAR z, era, doe, yoe, doy, mp, y, m : LINT; END_VAR\n  z := DATE_TO_LINT(IN) / 86400 + 719468;\n  IF z >= 0 THEN era := z / 146097; ELSE era := (z - 146096) / 146097; END_IF;\n  doe := z - era * 146097;\n  yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  doy := doe - (365 * yoe + yoe / 4 - yoe / 100);\n  mp := (5 * doy + 2) / 153;\n  DAY := LINT_TO_USINT(doy - (153 * mp + 2) / 5 + 1);\n  IF mp < 10 THEN m := mp + 3; ELSE m := mp - 9; END_IF;\n  y := yoe + era * 400;\n  IF m <= 2 THEN y := y + 1; END_IF;\n  MONTH := LINT_TO_USINT(m);\n  YEAR := LINT_TO_UINT(y);\n  SPLIT_DATE := TRUE;\nEND_FUNCTION\n\nFUNCTION SPLIT_TOD : BOOL\n  VAR_INPUT IN : TOD; END_VAR\n  VAR_OUTPUT HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR\n  VAR ms : LINT; END_VAR\n  ms := TOD_TO_LINT(IN);\n  HOUR := LINT_TO_USINT(ms / 3600000);\n  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);\n  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);\n  MILLISECOND := LINT_TO_UINT(ms MOD 1000);\n  SPLIT_TOD := TRUE;\nEND_FUNCTION\n\nFUNCTION SPLIT_LTOD : BOOL\n  VAR_INPUT IN : LTOD; END_VAR\n  VAR_OUTPUT HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR\n  VAR ms : LINT; END_VAR\n  ms := LTOD_TO_LINT(IN) / 1000000;\n  HOUR := LINT_TO_USINT(ms / 3600000);\n  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);\n  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);\n  MILLISECOND := LINT_TO_UINT(ms MOD 1000);\n  SPLIT_LTOD := TRUE;\nEND_FUNCTION\n\nFUNCTION SPLIT_LDT : BOOL\n  VAR_INPUT IN : LDT; END_VAR\n  VAR_OUTPUT YEAR : UINT; MONTH, DAY, HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR\n  VAR ns, days, ms, z, era, doe, yoe, doy, mp, y, m : LINT; END_VAR\n  ns := LDT_TO_LINT(IN);\n  days := ns / 86400000000000;\n  IF ns < 0 AND days * 86400000000000 <> ns THEN days := days - 1; END_IF;\n  z := days + 719468;\n  IF z >= 0 THEN era := z / 146097; ELSE era := (z - 146096) / 146097; END_IF;\n  doe := z - era * 146097;\n  yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  doy := doe - (365 * yoe + yoe / 4 - yoe / 100);\n  mp := (5 * doy + 2) / 153;\n  DAY := LINT_TO_USINT(doy - (153 * mp + 2) / 5 + 1);\n  IF mp < 10 THEN m := mp + 3; ELSE m := mp - 9; END_IF;\n  y := yoe + era * 400;\n  IF m <= 2 THEN y := y + 1; END_IF;\n  MONTH := LINT_TO_USINT(m);\n  YEAR := LINT_TO_UINT(y);\n  ms := (ns - days * 86400000000000) / 1000000;\n  HOUR := LINT_TO_USINT(ms / 3600000);\n  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);\n  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);\n  MILLISECOND := LINT_TO_UINT(ms MOD 1000);\n  SPLIT_LDT := TRUE;\nEND_FUNCTION\n\nFUNCTION SPLIT_DT : BOOL\n  VAR_INPUT IN : DT; END_VAR\n  VAR_OUTPUT YEAR : UINT; MONTH, DAY, HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR\n  VAR ns, days, ms, z, era, doe, yoe, doy, mp, y, m : LINT; END_VAR\n  ns := LDT_TO_LINT(DT_TO_LDT(IN));\n  days := ns / 86400000000000;\n  IF ns < 0 AND days * 86400000000000 <> ns THEN days := days - 1; END_IF;\n  z := days + 719468;\n  IF z >= 0 THEN era := z / 146097; ELSE era := (z - 146096) / 146097; END_IF;\n  doe := z - era * 146097;\n  yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  doy := doe - (365 * yoe + yoe / 4 - yoe / 100);\n  mp := (5 * doy + 2) / 153;\n  DAY := LINT_TO_USINT(doy - (153 * mp + 2) / 5 + 1);\n  IF mp < 10 THEN m := mp + 3; ELSE m := mp - 9; END_IF;\n  y := yoe + era * 400;\n  IF m <= 2 THEN y := y + 1; END_IF;\n  MONTH := LINT_TO_USINT(m);\n  YEAR := LINT_TO_UINT(y);\n  ms := (ns - days * 86400000000000) / 1000000;\n  HOUR := LINT_TO_USINT(ms / 3600000);\n  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);\n  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);\n  MILLISECOND := LINT_TO_UINT(ms MOD 1000);\n  SPLIT_DT := TRUE;\nEND_FUNCTION\n\nFUNCTION DAY_OF_WEEK : INT\n  VAR_INPUT IN : DATE; END_VAR\n  VAR days : LINT; END_VAR\n  days := DATE_TO_LINT(IN) / 86400;\n  DAY_OF_WEEK := LINT_TO_INT(((days MOD 7) + 7 + 4) MOD 7);\nEND_FUNCTION\n"
    }
  ]
}
