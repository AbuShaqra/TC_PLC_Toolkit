{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TwinCAT ST",
  "scopeName": "source.twincat-st",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.twincat-st",
          "match": "//.*$"
        },
        {
          "name": "comment.block.parenthesis.twincat-st",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        },
        {
          "name": "comment.block.slash-star.twincat-st",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.twincat-st",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.twincat-st",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.twincat-st",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.twincat-st",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.twincat-st",
          "match": "\\b16#[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.time.twincat-st",
          "match": "\\b[tT]#[0-9a-zA-Z_]+\\b"
        },
        {
          "name": "constant.numeric.float.twincat-st",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.twincat-st",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.twincat-st",
          "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|RETURN|EXIT|IMPLEMENTS|EXTENDS)\\b"
        },
        {
          "name": "keyword.declaration.twincat-st",
          "match": "(?i)\\b(VAR|END_VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_TEMP|VAR_STAT|VAR_EXTERNAL|CONSTANT|RETAIN|PERSISTENT|PROGRAM|FUNCTION_BLOCK|FUNCTION|TYPE|STRUCT|END_STRUCT|INTERFACE|END_INTERFACE|METHOD|END_METHOD|PROPERTY|END_PROPERTY|GET|END_GET|SET|END_SET|ACTION|END_ACTION)\\b"
        },
        {
          "name": "constant.language.twincat-st",
          "match": "(?i)\\b(TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.twincat-st",
          "match": "(?i)\\b(BOOL|BYTE|WORD|DWORD|LWORD|SINT|USINT|INT|UINT|DINT|UDINT|LINT|ULINT|REAL|LREAL|TIME|DATE|TOD|DT|LTIME|STRING|WSTRING|ARRAY|POINTER|REFERENCE|TO)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.twincat-st",
          "match": "(?i)\\b(AND|OR|XOR|NOT|MOD)\\b"
        },
        {
          "name": "keyword.operator.assignment.twincat-st",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.twincat-st",
          "match": "=|<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.twincat-st",
          "match": "\\+|-|\\*|/|\\^"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.twincat-st",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
