{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TwinCAT ST",
  "scopeName": "source.twincat-st",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragmas" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.twincat-st",
          "match": "//.*$"
        },
        {
          "name": "comment.block.parenthesis.twincat-st",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        },
        {
          "name": "comment.block.slash-star.twincat-st",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "pragmas": {
      "comment": "TwinCAT pragmas: the five categories Beckhoff documents at Infosys node 2529556363, plus a catch-all. Ordered BEFORE #strings in the top-level patterns on purpose - ST strings are single-quoted, so the apostrophe in {region \"Motion FB's\"} would otherwise open a string that runs to the next quote anywhere in the file. The webview's Monaco tokenizer has guarded against exactly that since it broke IntelliSense below a region; this grammar (VS Code's own editor, for loose .st files) had no pragma rule at all and carried the same latent bug. Every match stops at } or end of line, so a half-typed pragma cannot swallow the rest of the file either. Categories are decided by SHAPE alone - never by whether the name is in src/lsp/pragmas.js's catalog, because user-defined attributes are a supported TwinCAT feature and must not look wrong.",
      "patterns": [
        {
          "name": "keyword.control.directive.region.twincat-st",
          "match": "(?i)\\{\\s*(region|endregion)\\b[^}\\n]*\\}?"
        },
        {
          "name": "keyword.control.directive.conditional.twincat-st",
          "match": "(?i)\\{\\s*(IF|ELSIF|ELSE|END_IF|define|undefine)\\b[^}\\n]*\\}?"
        },
        {
          "name": "keyword.control.directive.message.twincat-st",
          "match": "(?i)\\{\\s*(text|info|warning|error)\\b[^}\\n]*\\}?"
        },
        {
          "name": "storage.modifier.attribute.twincat-st",
          "match": "\\{[^}\\n]*\\}?"
        }
      ]
    },
    "strings": {
      "comment": "The IEC 61131-3 escape character is the DOLLAR SIGN, never a backslash: $$ $' $\" $L $N $P $R $T (case-insensitive) and $ followed by two hex digits. Both blocks below used to carry \"\\\\.\" as their escape - inherited from a C-like grammar - which made a Windows path in a string swallow its own closing quote: 'C:\\Temp\\tc_json_append_test\\' ended in \\' , the literal never closed, and everything below it was painted as string until the next apostrophe anywhere in the file (in the reported case, one inside a // comment sixteen lines down). A backslash is an ORDINARY character in ST. src/lsp/parser.js and the Monarch tokenizer in media/editor.js implement the same rule; test_st_strings.js keeps all three in step.",
      "patterns": [
        {
          "name": "string.quoted.single.twincat-st",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.double.twincat-st",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escape" }
          ]
        }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.twincat-st",
      "match": "\\$(?:[$'\"LlNnPpRrTt]|[0-9A-Fa-f]{2})"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.twincat-st",
          "match": "\\b16#[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.time.twincat-st",
          "match": "\\b[tT]#[0-9a-zA-Z_]+\\b"
        },
        {
          "name": "constant.numeric.float.twincat-st",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.twincat-st",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.twincat-st",
          "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|RETURN|EXIT|IMPLEMENTS|EXTENDS)\\b"
        },
        {
          "name": "keyword.declaration.twincat-st",
          "match": "(?i)\\b(VAR|END_VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_TEMP|VAR_STAT|VAR_EXTERNAL|CONSTANT|RETAIN|PERSISTENT|PROGRAM|FUNCTION_BLOCK|FUNCTION|TYPE|STRUCT|END_STRUCT|INTERFACE|END_INTERFACE|METHOD|END_METHOD|PROPERTY|END_PROPERTY|GET|END_GET|SET|END_SET|ACTION|END_ACTION)\\b"
        },
        {
          "name": "constant.language.twincat-st",
          "match": "(?i)\\b(TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.twincat-st",
          "match": "(?i)\\b(BOOL|BYTE|WORD|DWORD|LWORD|SINT|USINT|INT|UINT|DINT|UDINT|LINT|ULINT|REAL|LREAL|TIME|DATE|TOD|DT|LTIME|STRING|WSTRING|ARRAY|POINTER|REFERENCE|TO)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.twincat-st",
          "match": "(?i)\\b(AND|OR|XOR|NOT|MOD)\\b"
        },
        {
          "name": "keyword.operator.assignment.twincat-st",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.twincat-st",
          "match": "=|<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.twincat-st",
          "match": "\\+|-|\\*|/|\\^"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.twincat-st",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
