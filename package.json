{
  "name": "twincat-plc-toolkit",
  "displayName": "TC Toolkit",
  "description": "Structured Text editor, language server and project tools for Beckhoff TwinCAT 3 PLC projects: two-pane editor, offline IntelliSense and diagnostics, object and library explorers. Unofficial; not affiliated with Beckhoff.",
  "version": "0.10.1",
  "publisher": "a-abushaqra",
  "license": "AGPL-3.0-or-later",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbuShaqra/TC_PLC_Toolkit.git"
  },
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node test/run.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "activationEvents": [
    "onLanguage:twincat-st",
    "onView:twincatStart",
    "onView:twincatExplorer",
    "onView:twincatLibraries",
    "onCustomEditor:twincat.xmlViewer",
    "onWebviewPanel:twincat.startPage",
    "onCommand:twincat.openStartPage",
    "onCommand:twincat.createProject",
    "onCommand:twincat.openProject",
    "onCommand:twincat.generateSt",
    "onCommand:twincat.compileProject",
    "onCommand:twincat.openSettings",
    "onCommand:twincat.detectXaeShell",
    "onCommand:twincat.openGettingStarted",
    "onCommand:twincat.openRoadmap",
    "onCommand:twincat.openReleaseNotes",
    "onCommand:twincat.reportIssue",
    "onCommand:twincat.updateLibraryDefinitions"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "twincat.xmlViewer",
        "displayName": "TC Toolkit",
        "selector": [
          {
            "filenamePattern": "*.TcPOU"
          },
          {
            "filenamePattern": "*.TcGVL"
          },
          {
            "filenamePattern": "*.TcDUT"
          },
          {
            "filenamePattern": "*.TcIO"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "twincat",
          "title": "TC Toolkit",
          "icon": "media/twincat-activitybar.svg"
        }
      ],
      "panel": [
        {
          "id": "twincat-references-panel",
          "title": "PLC References",
          "icon": "$(references)"
        }
      ]
    },
    "views": {
      "twincat": [
        {
          "id": "twincatStart",
          "name": "Start"
        },
        {
          "id": "twincatExplorer",
          "name": "PLC Objects"
        },
        {
          "id": "twincatLibraries",
          "name": "PLC Libraries"
        }
      ],
      "twincat-references-panel": [
        {
          "id": "twincatReferences",
          "name": "PLC References"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "twincatStart",
        "contents": "Create a TwinCAT 3 project, or open one.\n[Create New Project…](command:twincat.createProject)\n[Open Existing Project…](command:twincat.openProject)\n[Open Start Page](command:twincat.openStartPage)\n[Getting started](command:twincat.openGettingStarted) · [Roadmap](https://claude.ai/artifact/8RG7TZtBV2cuupsrwWtknv) · [Release notes](https://github.com/AbuShaqra/TC_PLC_Toolkit/releases) · [Report an issue](https://github.com/AbuShaqra/TC_PLC_Toolkit/issues) · [Settings](command:twincat.openSettings)"
      },
      {
        "view": "twincatExplorer",
        "contents": "No TwinCAT project in this workspace.\n[Create New Project…](command:twincat.createProject)\n[Open Existing Project…](command:twincat.openProject)"
      },
      {
        "view": "twincatReferences",
        "contents": "No references yet. Right-click a symbol in the editor and choose \"Go to References\"."
      },
      {
        "view": "twincatLibraries",
        "contents": "No TwinCAT libraries found. Open a folder containing a .plcproj file."
      }
    ],
    "commands": [
      {
        "command": "twincat.openStartPage",
        "title": "Open Start Page",
        "category": "TC Toolkit",
        "icon": "$(home)"
      },
      {
        "command": "twincat.createProject",
        "title": "Create New Project…",
        "category": "TC Toolkit",
        "icon": "$(new-folder)"
      },
      {
        "command": "twincat.openProject",
        "title": "Open Existing Project…",
        "category": "TC Toolkit",
        "icon": "$(folder-opened)"
      },
      {
        "command": "twincat.generateSt",
        "title": "Generate ST",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.compileProject",
        "title": "Compile Project",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.openSettings",
        "title": "Open Settings",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.detectXaeShell",
        "title": "Detect XAE Shell Installations",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.openGettingStarted",
        "title": "Getting Started",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.openRoadmap",
        "title": "Open Roadmap",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.openReleaseNotes",
        "title": "Release Notes",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.reportIssue",
        "title": "Report an Issue",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.openComponent",
        "title": "Open Component"
      },
      {
        "command": "twincat.createMethod",
        "title": "Create Method",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createProperty",
        "title": "Create Property",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createVirtualFolder",
        "title": "Create Virtual Folder",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.addGetAccessor",
        "title": "Add Get Accessor",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.addSetAccessor",
        "title": "Add Set Accessor",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.deleteComponent",
        "title": "Delete Component",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.deleteVirtualFolder",
        "title": "Delete Virtual Folder",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createAction",
        "title": "Create Action",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createFileFB",
        "title": "Create Function Block (FB)",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createFileProgram",
        "title": "Create Program (PRG)",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createFileFunction",
        "title": "Create Function (FUN)",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createFileInterface",
        "title": "Create Interface (ITF)",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createFileGVL",
        "title": "Create Global Variable List (GVL)",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.createPhysicalFolder",
        "title": "Create Folder",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.deletePhysicalItem",
        "title": "Delete",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.clearReferences",
        "title": "Clear References",
        "category": "TC Toolkit",
        "icon": "$(clear-all)"
      },
      {
        "command": "twincat.insertAtCursor",
        "title": "Insert at Cursor",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.insertDefinitionAtCursor",
        "title": "Insert Definition at Cursor",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.insertObjectAtCursor",
        "title": "Insert at Cursor",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.insertObjectDefinitionAtCursor",
        "title": "Insert Definition at Cursor",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.copyLibraryNamespace",
        "title": "Copy Namespace",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.copyQualifiedName",
        "title": "Copy Qualified Name",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.refreshLibraries",
        "title": "Refresh",
        "category": "TC Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "twincat.updateLibraryDefinitions",
        "title": "Update Library Definitions (requires TwinCAT)",
        "category": "TC Toolkit",
        "icon": "$(cloud-download)"
      },
      {
        "command": "twincat.copyObject",
        "title": "Copy",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.pasteObject",
        "title": "Paste",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.renameObject",
        "title": "Rename",
        "category": "TC Toolkit"
      },
      {
        "command": "twincat.undoLastRename",
        "title": "Undo Last Rename",
        "category": "TC Toolkit"
      }
    ],
    "keybindings": [
      {
        "command": "twincat.copyObject",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == twincatExplorer"
      },
      {
        "command": "twincat.pasteObject",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == twincatExplorer && twincat.canPaste"
      },
      {
        "command": "twincat.renameObject",
        "key": "f2",
        "when": "focusedView == twincatExplorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "twincat.openStartPage",
          "when": "view == twincatStart",
          "group": "navigation@1"
        },
        {
          "command": "twincat.clearReferences",
          "when": "view == twincatReferences",
          "group": "navigation"
        },
        {
          "command": "twincat.updateLibraryDefinitions",
          "when": "view == twincatLibraries",
          "group": "navigation@1"
        },
        {
          "command": "twincat.refreshLibraries",
          "when": "view == twincatLibraries",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "twincat.addGetAccessor",
          "when": "false"
        },
        {
          "command": "twincat.addSetAccessor",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "twincat.insertAtCursor",
          "when": "view == twincatLibraries && (viewItem == 'twincatLibrary' || viewItem == 'twincatLibraryType' || viewItem == 'twincatLibraryMethod' || viewItem == 'twincatLibraryMember')",
          "group": "twincat_1_insert@1"
        },
        {
          "command": "twincat.insertDefinitionAtCursor",
          "when": "view == twincatLibraries && (viewItem == 'twincatLibraryType' || viewItem == 'twincatLibraryMethod')",
          "group": "twincat_1_insert@2"
        },
        {
          "command": "twincat.copyLibraryNamespace",
          "when": "view == twincatLibraries && viewItem == 'twincatLibrary'",
          "group": "twincat_2_copy@1"
        },
        {
          "command": "twincat.copyQualifiedName",
          "when": "view == twincatLibraries && viewItem == 'twincatLibraryType'",
          "group": "twincat_2_copy@2"
        },
        {
          "command": "twincat.insertObjectAtCursor",
          "when": "view == twincatExplorer && (viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'pouFileFunction' || viewItem == 'itfFile' || viewItem == 'gvlFile' || viewItem == 'dutFile' || viewItem == 'component' || viewItem =~ /^propertyNode\\b/)",
          "group": "1_insert@1"
        },
        {
          "command": "twincat.insertObjectDefinitionAtCursor",
          "when": "view == twincatExplorer && (viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'pouFileFunction' || viewItem == 'component')",
          "group": "1_insert@2"
        },
        {
          "command": "twincat.createMethod",
          "when": "view == twincatExplorer && (viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'itfFile' || viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram' || viewItem == 'pouVirtualFolderInterface')",
          "group": "twincat@1"
        },
        {
          "command": "twincat.createProperty",
          "when": "view == twincatExplorer && (viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'itfFile' || viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram' || viewItem == 'pouVirtualFolderInterface')",
          "group": "twincat@2"
        },
        {
          "command": "twincat.createAction",
          "when": "view == twincatExplorer && (viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram')",
          "group": "twincat@2.5"
        },
        {
          "command": "twincat.createVirtualFolder",
          "when": "view == twincatExplorer && (viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'itfFile' || viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram' || viewItem == 'pouVirtualFolderInterface')",
          "group": "twincat@3"
        },
        {
          "command": "twincat.addGetAccessor",
          "when": "view == twincatExplorer && viewItem =~ /^propertyNode\\.noGet\\b/",
          "group": "twincat@3.1"
        },
        {
          "command": "twincat.addSetAccessor",
          "when": "view == twincatExplorer && viewItem =~ /^propertyNode\\b.*\\.noSet\\b/",
          "group": "twincat@3.2"
        },
        {
          "command": "twincat.deleteComponent",
          "when": "view == twincatExplorer && (viewItem == 'component' || viewItem =~ /^propertyNode\\b/)",
          "group": "twincat@4"
        },
        {
          "command": "twincat.deleteVirtualFolder",
          "when": "view == twincatExplorer && (viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram' || viewItem == 'pouVirtualFolderInterface')",
          "group": "twincat@5"
        },
        {
          "command": "twincat.createPhysicalFolder",
          "when": "view == twincatExplorer && viewItem == 'directory'",
          "group": "twincat_new@0"
        },
        {
          "command": "twincat.createFileFB",
          "when": "view == twincatExplorer && viewItem == 'directory'",
          "group": "twincat_new@1"
        },
        {
          "command": "twincat.createFileProgram",
          "when": "view == twincatExplorer && viewItem == 'directory'",
          "group": "twincat_new@2"
        },
        {
          "command": "twincat.createFileFunction",
          "when": "view == twincatExplorer && viewItem == 'directory'",
          "group": "twincat_new@3"
        },
        {
          "command": "twincat.createFileInterface",
          "when": "view == twincatExplorer && viewItem == 'directory'",
          "group": "twincat_new@4"
        },
        {
          "command": "twincat.createFileGVL",
          "when": "view == twincatExplorer && viewItem == 'directory'",
          "group": "twincat_new@5"
        },
        {
          "command": "twincat.deletePhysicalItem",
          "when": "view == twincatExplorer && (viewItem == 'directory' || viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'pouFileFunction' || viewItem == 'itfFile' || viewItem == 'gvlFile' || viewItem == 'dutFile' || viewItem == 'stFile')",
          "group": "twincat@6"
        },
        {
          "command": "twincat.copyObject",
          "when": "view == twincatExplorer && (viewItem == 'component' || viewItem =~ /^propertyNode\\b/ || viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'pouFileFunction' || viewItem == 'itfFile' || viewItem == 'gvlFile' || viewItem == 'dutFile' || viewItem == 'stFile')",
          "group": "twincat_0_clipboard@1"
        },
        {
          "command": "twincat.pasteObject",
          "when": "view == twincatExplorer && twincat.canPaste && (viewItem == 'directory' || viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'itfFile' || viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram' || viewItem == 'pouVirtualFolderInterface' || viewItem == 'component' || viewItem =~ /^propertyNode\\b/)",
          "group": "twincat_0_clipboard@2"
        },
        {
          "command": "twincat.renameObject",
          "when": "view == twincatExplorer && (viewItem == 'directory' || viewItem == 'pouFile' || viewItem == 'pouFileProgram' || viewItem == 'pouFileFunction' || viewItem == 'itfFile' || viewItem == 'gvlFile' || viewItem == 'dutFile' || viewItem == 'stFile' || viewItem == 'component' || viewItem =~ /^propertyNode\\b/ || viewItem == 'pouVirtualFolder' || viewItem == 'pouVirtualFolderProgram' || viewItem == 'pouVirtualFolderInterface')",
          "group": "twincat_0_clipboard@3"
        }
      ]
    },
    "languages": [
      {
        "id": "twincat-st",
        "aliases": [
          "TwinCAT ST",
          "Structured Text",
          "st"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twincat-st",
        "scopeName": "source.twincat-st",
        "path": "./syntaxes/twincat-st.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TC Toolkit",
      "properties": {
        "twincat.diagnostics.memberAccess": {
          "type": "boolean",
          "default": true,
          "description": "Flag access to members that do not exist on a resolved type (e.g. fb.NoSuchField)."
        },
        "twincat.diagnostics.callArguments": {
          "type": "boolean",
          "default": true,
          "description": "Flag named call arguments that are not parameters of the resolved function/FB/method."
        },
        "twincat.diagnostics.declarationTypes": {
          "type": "boolean",
          "default": false,
          "description": "Flag declarations whose type is unknown. Off by default: types from library archives that cannot be read (the opaque .compiled-library-v3 format) are invisible to the indexer, so this may report false positives in projects that use them."
        },
        "twincat.diagnostics.typeCompatibility": {
          "type": "boolean",
          "default": true,
          "description": "Flag assignments whose value type is clearly incompatible with the target (e.g. assigning a struct to an INT)."
        },
        "twincat.libraryDefinitions.shell": {
          "type": "string",
          "enum": [
            "ask",
            "x64",
            "x86"
          ],
          "enumDescriptions": [
            "Ask every time which XAE Shell to use.",
            "Always use the 64-bit TcXaeShell (TcXaeShell.DTE.17.0).",
            "Always use the 32-bit TcXaeShell (TcXaeShell.DTE.15.0)."
          ],
          "default": "ask",
          "markdownDescription": "Which TwinCAT XAE Shell **Update Library Definitions** should drive. A library's signatures can differ between the 32-bit and 64-bit shell — visualisation libraries especially — so this defaults to asking. Set it if you always build with the same one. If the chosen shell is not installed, you are asked anyway rather than given the wrong signatures."
        },
        "twincat.startPage.recentProjectsShown": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "markdownDescription": "How many recent TwinCAT solutions the start page lists under **Open existing project**. When more are remembered (up to 10), a **Show all** tile expands the list."
        },
        "twincat.xaeShell.path4024": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to `TcXaeShell.exe` of the XAE Shell for **TwinCAT 3.1.4024** (the 32-bit shell). Filled automatically with the installation found on this machine; change it if yours is elsewhere. Empty = not found. Run **TC Toolkit: Detect XAE Shell Installations** to look again."
        },
        "twincat.xaeShell.path4026": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to `TcXaeShell.exe` of the XAE Shell for **TwinCAT 3.1.4026** (the 64-bit shell). Filled automatically with the installation found on this machine; change it if yours is elsewhere. Empty = not found. Run **TC Toolkit: Detect XAE Shell Installations** to look again."
        },
        "twincat.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to the command-line file (`.cjs`) of an external IEC 61131-3 compiler for **TC Toolkit: Compile Project** to run instead of the one that ships with the extension. Empty = the bundled compiler (the usual choice)."
        },
        "twincat.compiler.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to a Node.js executable, version 22 or newer, that runs the compiler for **TC Toolkit: Compile Project**. Empty = found automatically: `node` on `PATH`, then on Windows the usual install locations (Node.js installer, nvm-windows, Volta, fnm), then VS Code's own runtime when it is Node.js 22 or newer. The version is checked before each run."
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.66.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
